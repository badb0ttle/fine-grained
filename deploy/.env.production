# AllOfAI Backend — Production environment (ECS)
# Copy to /root/fine-grained/.env on ECS

# ── Server ──
AI_INTEL_API_HOST=127.0.0.1
AI_INTEL_API_PORT=8001
AI_INTEL_CORS_ORIGINS=https://ai.hjhai.xyz,http://localhost:5173

# ── Database ──
AI_INTEL_DB_PATH=/root/fine-grained/data/ai_intel.db

# ── API Key — generate with: python3 -c "import secrets; print('crn_'+secrets.token_hex(16))" ──
# REPLACE with real key before deploying!
AI_INTEL_API_KEY=crn_R...PLACE_ME_WITH_REAL_KEY

# ── Limits ──
AI_INTEL_MAX_ARTICLES_PER_BATCH=100

# ── API Client (for cron → API calls) ──
AI_INTEL_API_BASE=http://127.0.0.1:8001
AI_INTEL_API_ENABLED=1
